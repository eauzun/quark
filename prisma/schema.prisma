generator client {
  provider = "prisma-client-js"
}
datasource db {
  provider = "postgresql"
  url = env("DATABASE_URL")
}
model User {
  wallet String @id
  username String? @unique
  displayName String @default("")
  companyName String @default("")
  activeRole String @default("worker")
  createdAt DateTime @default(now())
}
model AuthNonce {
  nonce String @id
  expiresAt DateTime
}
model TaskMetadata {
  id String @id @default(cuid())
  chainId String? @unique
  employer String
  title String
  description String
  category String
  level String
  amount String
  deadline BigInt
  txHash String? @unique
  createdAt DateTime @default(now())
}
model Application {
  id String @id @default(cuid())
  taskId String
  worker String
  createdAt DateTime @default(now())
  @@unique([taskId, worker])
}
model Delivery {
  id String @id @default(cuid())
  taskId String
  worker String
  url String
  hash String
  createdAt DateTime @default(now())
  @@unique([taskId, hash])
}
model Skill {
  id String @id
  name String
  level String
}
model SkillQuestion {
  id String @id
  skillId String
  question String
  options Json
  correctOption Int
}
model SkillAttempt {
  id String @id @default(cuid())
  worker String
  skillId String
  questionIds Json
  expiresAt DateTime
  score Int?
  passed Boolean @default(false)
  completedAt DateTime?
  attemptedAt DateTime @default(now())
  @@index([worker, skillId, attemptedAt])
}
model EcosystemProgram {
  id String @id
  title String
  description String
  url String
  program String
  active Boolean @default(true)
}
model CommunityProject {
  id String @id
  name String
  category String
  description String
  url String
  employer String?
}
model Review {
  id String @id @default(cuid())
  taskId String
  reviewer String
  reviewee String
  reviewerRole String
  rating Int
  comment String
  createdAt DateTime @default(now())
  @@unique([taskId, reviewer])
  @@index([reviewee])
}
